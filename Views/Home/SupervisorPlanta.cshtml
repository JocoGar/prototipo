@{
    ViewData["Title"] = "Supervisor de Planta";
}

<section class="mb-6">
    <div class="flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Supervisor de Planta</h1>
            <p class="mt-1 text-sm text-slate-500">
                Control de transformación de materia prima, producto terminado y merma operativa.
            </p>
        </div>

        <button class="rounded-xl bg-emerald-900 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-800">
            Registrar transformación
        </button>
    </div>
</section>

<section class="grid gap-4 md:grid-cols-4">
    <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-medium text-slate-500">Materia prima procesada</p>
        <h2 class="mt-2 text-2xl font-bold text-slate-900">12,400 lb</h2>
        <p class="mt-2 text-xs text-slate-500">Jornada actual</p>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-medium text-slate-500">Producto terminado</p>
        <h2 class="mt-2 text-2xl font-bold text-emerald-700">118 packs</h2>
        <p class="mt-2 text-xs text-slate-500">Packs de 100 lb</p>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-medium text-slate-500">Merma promedio</p>
        <h2 class="mt-2 text-2xl font-bold text-slate-900">4.2%</h2>
        <p class="mt-2 text-xs text-emerald-700">Dentro del límite aceptado</p>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-medium text-slate-500">Alertas de merma</p>
        <h2 class="mt-2 text-2xl font-bold text-red-600">1</h2>
        <p class="mt-2 text-xs text-red-600">Superó el 5%</p>
    </div>
</section>

<section class="mt-6 rounded-2xl border border-slate-200 bg-white">
    <div class="border-b border-slate-200 p-5">
        <h3 class="font-bold text-slate-900">Transformaciones recientes</h3>
        <p class="text-sm text-slate-500">Control de entrada, salida y merma calculada.</p>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
            <thead class="bg-slate-50 text-xs uppercase text-slate-500">
                <tr>
                    <th class="px-5 py-3">Lote origen</th>
                    <th class="px-5 py-3">Producto terminado</th>
                    <th class="px-5 py-3">Entrada</th>
                    <th class="px-5 py-3">Salida</th>
                    <th class="px-5 py-3 text-right">Merma</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                <tr>
                    <td class="px-5 py-3 font-medium">MP-1201</td>
                    <td class="px-5 py-3 text-slate-600">Frijol empacado</td>
                    <td class="px-5 py-3">5,000 lb</td>
                    <td class="px-5 py-3">4,820 lb</td>
                    <td class="px-5 py-3 text-right">
                        <span class="rounded-full bg-emerald-50 px-2 py-1 text-xs font-semibold text-emerald-700">3.6%</span>
                    </td>
                </tr>

                <tr>
                    <td class="px-5 py-3 font-medium">MP-1202</td>
                    <td class="px-5 py-3 text-slate-600">Harina empacada</td>
                    <td class="px-5 py-3">4,000 lb</td>
                    <td class="px-5 py-3">3,720 lb</td>
                    <td class="px-5 py-3 text-right">
                        <span class="rounded-full bg-red-50 px-2 py-1 text-xs font-semibold text-red-700">7.0%</span>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</section>