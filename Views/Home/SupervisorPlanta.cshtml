</div>
<!-- Toast Notification (Hidden by default) -->
<div class="hidden fixed top-20 right-margin-desktop bg-primary-container text-on-primary-container px-lg py-md rounded-lg shadow-lg z-50 flex items-center gap-md transition-opacity duration-300 opacity-0 transform translate-y-[-20px]" id="successToast">
