<span class="font-body-md text-body-md font-medium">Lote terminado registrado correctamente.</span>
<button class="ml-sm hover:opacity-80" onclick="hideToast()">
<span class="material-symbols-outlined" data-icon="close">close</span>
</button>
</div>
<!-- Tablet-Optimized Grid Layout -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-lg">
<!-- Registro de Lote Form (Takes up 5 columns on large screens) -->
<section class="lg:col-span-5 bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant overflow-hidden flex flex-col h-full">
<div class="bg-surface-container-low px-lg py-md border-b border-outline-variant flex items-center gap-md">
<span class="material-symbols-outlined text-primary" data-icon="add_box">add_box</span>
<h3 class="font-title-lg text-title-lg text-on-surface">Registro de Lote</h3>
</div>
<div class="p-lg flex-1 flex flex-col gap-lg">
<!-- Producto -->
<div class="flex flex-col gap-xs">
<label class="font-label-md text-label-md text-on-surface-variant">Producto</label>
<div class="relative">
<select class="w-full h-14 bg-surface appearance-none border border-outline-variant rounded-lg px-md py-sm font-body-lg text-body-lg text-on-surface focus:border-secondary focus:ring-1 focus:ring-secondary transition-colors cursor-pointer"><option disabled="" selected="" value="">Seleccionar producto...</option>
<option value="p1">Maíz Blanco en Grano (Saco 50kg)</option>
<option value="p2">Maíz Amarillo en Grano (Saco 50kg)</option>
<option value="p3">Harina de Maíz Nixtamalizada</option></select>
<span class="material-symbols-outlined absolute right-md top-1/2 transform -translate-y-1/2 text-on-surface-variant pointer-events-none" data-icon="arrow_drop_down">arrow_drop_down</span>
</div>
</div>
<!-- Tipo de Lote & Bodega -->
<div class="grid grid-cols-2 gap-md">
<div class="flex flex-col gap-xs">
<label class="font-label-md text-label-md text-on-surface-variant">Tipo de Lote</label>
<div class="relative">
<select class="w-full h-14 bg-surface appearance-none border border-outline-variant rounded-lg px-md py-sm font-body-lg text-body-lg text-on-surface focus:border-secondary focus:ring-1 focus:ring-secondary transition-colors cursor-pointer"><option disabled="" selected="" value="">Seleccionar producto...</option>
<option value="p1">Maíz Blanco en Grano (Saco 50kg)</option>
<option value="p2">Maíz Amarillo en Grano (Saco 50kg)</option>
<option value="p3">Harina de Maíz Nixtamalizada</option></select>
<span class="material-symbols-outlined absolute right-md top-1/2 transform -translate-y-1/2 text-on-surface-variant pointer-events-none" data-icon="arrow_drop_down">arrow_drop_down</span>
</div>
</div>
<div class="flex flex-col gap-xs">
<label class="font-label-md text-label-md text-on-surface-variant">Bodega</label>
<div class="relative">
<select class="w-full h-14 bg-surface appearance-none border border-outline-variant rounded-lg px-md py-sm font-body-lg text-body-lg text-on-surface focus:border-secondary focus:ring-1 focus:ring-secondary transition-colors cursor-pointer"><option disabled="" selected="" value="">Seleccionar producto...</option>
<option value="p1">Maíz Blanco en Grano (Saco 50kg)</option>
<option value="p2">Maíz Amarillo en Grano (Saco 50kg)</option>
<option value="p3">Harina de Maíz Nixtamalizada</option></select>
<span class="material-symbols-outlined absolute right-md top-1/2 transform -translate-y-1/2 text-on-surface-variant pointer-events-none" data-icon="arrow_drop_down">arrow_drop_down</span>
</div>
</div>
</div>
<!-- Cantidad Inicial & Auto-Gen Code -->
<div class="grid grid-cols-2 gap-md">
<div class="flex flex-col gap-xs">
<label class="font-label-md text-label-md text-on-surface-variant">Cantidad Inicial (kg)</label>
<input class="w-full h-14 bg-surface border border-outline-variant rounded-lg px-md py-sm font-body-lg text-body-lg text-on-surface focus:border-secondary focus:ring-1 focus:ring-secondary transition-colors touch-manipulation" placeholder="0.00" type="number">
</div>
<div class="flex flex-col gap-xs">
<label class="font-label-md text-label-md text-on-surface-variant">Código de Lote</label>
<div class="w-full h-14 bg-surface-container-high border border-outline-variant rounded-lg px-md flex items-center justify-between">
<span class="font-code-md text-code-md text-on-surface-variant">AUTOGEN-PEND</span>
<span class="material-symbols-outlined text-outline" data-icon="tag">tag</span>
</div>
</div>
</div>
</div>
</section>
<!-- Transformación de Materia Prima Form (Takes up 7 columns on large screens) -->
<section class="lg:col-span-7 bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant overflow-hidden flex flex-col h-full relative">
<!-- Subtle background pattern for transformation area -->
<div class="absolute inset-0 opacity-5 pointer-events-none" style="background-image: radial-gradient(#1b5e20 1px, transparent 1px); background-size: 20px 20px;"></div>
<div class="bg-primary-container px-lg py-md border-b border-outline-variant flex items-center justify-between relative z-10">
<div class="flex items-center gap-md">
<span class="material-symbols-outlined text-on-primary-container" data-icon="transform">transform</span>
<h3 class="font-title-lg text-title-lg text-on-primary-container">Transformación de Materia Prima</h3>
</div>
<span class="px-sm py-xs bg-surface-container-lowest/20 rounded-md font-label-md text-label-md text-on-primary-container">Modo Tablet</span>
</div>
<div class="p-lg flex-1 flex flex-col gap-lg relative z-10">
<!-- Lote Origen & Producto Resultante -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-lg items-end">
<div class="flex flex-col gap-xs">
<label class="font-label-md text-label-md text-on-surface-variant">Lote Origen (Materia Prima)</label>
<div class="relative group">
<select class="w-full h-14 bg-surface appearance-none border border-outline-variant rounded-lg px-md py-sm font-body-lg text-body-lg text-on-surface focus:border-secondary focus:ring-1 focus:ring-secondary transition-colors cursor-pointer"><option disabled="" selected="" value="">Seleccionar Lote...</option>
<option value="l1">LOT-CRN-2023-01A (Maíz Blanco en Grano) - 1000kg</option>
<option value="l2">LOT-CRN-2023-01B (Maíz Amarillo en Grano) - 800kg</option></select>
<span class="material-symbols-outlined absolute right-md top-1/2 transform -translate-y-1/2 text-on-surface-variant pointer-events-none" data-icon="search">search</span>
</div>
</div>
<div class="flex justify-center md:hidden my-xs">
<span class="material-symbols-outlined text-outline-variant transform rotate-90" data-icon="arrow_forward">arrow_forward</span>
</div>
<div class="flex flex-col gap-xs">
<label class="font-label-md text-label-md text-on-surface-variant">Producto Resultante</label>
<div class="relative">
<select class="w-full h-14 bg-surface appearance-none border border-outline-variant rounded-lg px-md py-sm font-body-lg text-body-lg text-on-surface focus:border-secondary focus:ring-1 focus:ring-secondary transition-colors cursor-pointer"><option disabled="" selected="" value="">Seleccionar Destino...</option>
<option value="d1">Harina de Maíz (Saco 25kg)</option>
<option value="d2">Mezcla para Tortillas (Lote Industrial)</option></select>
<span class="material-symbols-outlined absolute right-md top-1/2 transform -translate-y-1/2 text-on-surface-variant pointer-events-none" data-icon="arrow_drop_down">arrow_drop_down</span>
</div>
</div>
</div>
<!-- Metrics Bento Box -->
<div class="grid grid-cols-3 gap-md bg-surface-container-low p-md rounded-xl border border-outline-variant">
<div class="flex flex-col items-center justify-center p-md bg-surface rounded-lg border border-outline-variant shadow-sm">
<span class="font-label-md text-label-md text-on-surface-variant mb-xs">Peso Entrada</span>
<div class="flex items-end gap-xs">
<input class="w-24 h-12 text-center font-headline-md text-headline-md text-on-surface bg-transparent border-b-2 border-outline focus:border-primary focus:ring-0 px-0 py-0 touch-manipulation" id="pesoEntrada" oninput="calculateMerma()" type="number" value="500">
<span class="font-body-md text-body-md text-on-surface-variant pb-1">kg</span>
</div>
</div>
<div class="flex flex-col items-center justify-center p-md bg-surface rounded-lg border border-outline-variant shadow-sm">
<span class="font-label-md text-label-md text-on-surface-variant mb-xs">Peso Salida</span>
<div class="flex items-end gap-xs">
<input class="w-24 h-12 text-center font-headline-md text-headline-md text-on-surface bg-transparent border-b-2 border-outline focus:border-primary focus:ring-0 px-0 py-0 touch-manipulation" id="pesoSalida" oninput="calculateMerma()" type="number" value="475">
<span class="font-body-md text-body-md text-on-surface-variant pb-1">kg</span>
</div>
</div>
<div class="flex flex-col items-center justify-center p-md bg-error-container/30 rounded-lg border border-error/20">
<span class="font-label-md text-label-md text-error mb-xs">% Merma Calculado</span>
<div class="flex items-baseline gap-xs">
<span class="font-headline-lg text-headline-lg font-bold text-error" id="mermaValue">5.0</span>
<span class="font-body-md text-body-md text-error">%</span>
</div>
</div>
</div>
<!-- Observaciones -->
<div class="flex flex-col gap-xs flex-1">
<label class="font-label-md text-label-md text-on-surface-variant">Observaciones</label>
<textarea class="w-full flex-1 min-h-[100px] bg-surface border border-outline-variant rounded-lg px-md py-sm font-body-md text-body-md text-on-surface focus:border-secondary focus:ring-1 focus:ring-secondary transition-colors resize-none" placeholder="Añadir notas sobre calidad, empaque o incidencias durante la transformación..."></textarea>
</div>
</div>
<!-- Action Bar -->
<div class="p-lg bg-surface-container border-t border-outline-variant flex justify-end gap-md relative z-10">
<button class="h-14 px-lg rounded-full font-label-md text-label-md text-secondary border border-secondary hover:bg-secondary/10 transition-colors flex items-center justify-center min-w-[140px]">
                            Cancelar
                        </button>
<button class="h-14 px-xl rounded-full font-label-md text-label-md text-on-primary bg-primary hover:bg-primary-container hover:text-on-primary-container transition-colors shadow-sm flex items-center justify-center gap-sm min-w-[200px]" onclick="saveLote()">
<span class="material-symbols-outlined" data-icon="save">save</span>
                            Guardar y Finalizar
                        </button>
</div>
</section>
</div>
</main>
</div>
<script>
        // Micro-interaction for % Merma Calculation
        function calculateMerma() {
            const entrada = parseFloat(document.getElementById('pesoEntrada').value) || 0;
            const salida = parseFloat(document.getElementById('pesoSalida').value) || 0;
            const mermaElement = document.getElementById('mermaValue');
            const containerElement = mermaElement.parentElement.parentElement;
            
            if (entrada > 0) {
                let merma = ((entrada - salida) / entrada) * 100;
                merma = Math.max(0, merma).toFixed(1);
                mermaElement.innerText = merma;

                // Visual cue based on threshold (e.g., > 10% is bad)
                if (merma > 10) {
                    containerElement.classList.remove('bg-surface', 'border-outline-variant', 'text-on-surface');
                    containerElement.classList.add('bg-error-container/30', 'border-error/20');
                    mermaElement.classList.remove('text-on-surface');
                    mermaElement.classList.add('text-error');
                    mermaElement.nextElementSibling.classList.remove('text-on-surface-variant');
                    mermaElement.nextElementSibling.classList.add('text-error');
                } else {
                    containerElement.classList.add('bg-surface', 'border-outline-variant');
                    containerElement.classList.remove('bg-error-container/30', 'border-error/20');
                    mermaElement.classList.add('text-on-surface');
                    mermaElement.classList.remove('text-error');
                    mermaElement.nextElementSibling.classList.add('text-on-surface-variant');
                    mermaElement.nextElementSibling.classList.remove('text-error');
                }
            } else {
                mermaElement.innerText = "0.0";
            }
        }

        // Toast Notification Logic
        function saveLote() {
            const toast = document.getElementById('successToast');
            toast.classList.remove('hidden');
            
            // Small delay to allow display:block to apply before animating opacity
            setTimeout(() => {
                toast.classList.remove('opacity-0', 'translate-y-[-20px]');
                toast.classList.add('opacity-100', 'translate-y-0');
            }, 10);

            // Auto hide after 4 seconds
            setTimeout(() => {
                hideToast();
            }, 4000);
            
            // Add a subtle ripple or scale effect to the button could go here
        }

        function hideToast() {
            const toast = document.getElementById('successToast');
            toast.classList.remove('opacity-100', 'translate-y-0');
            toast.classList.add('opacity-0', 'translate-y-[-20px]');
            
            // Wait for transition to finish before hiding
            setTimeout(() => {
                toast.classList.add('hidden');
            }, 300);
        }
    </script>

<script>
(function () {
  const rutas = {
    "Dashboard": "/Home/Dashboard",
    "BI Gerencial": "/Home/GerenciaBI",
    "Compras": "/Home/Compras",
    "Marketing": "/Home/Marketing",
    "Contabilidad": "/Home/Contabilidad",
    "Ventas": "/Home/Ventas",
    "Inventario": "/Home/SupervisorBodega",
    "Alertas": "/Home/Alertas",
    "Reportes": "/Home/Reportes",
    "Usuarios": "/Home/Administracion"
  };

  document.querySelectorAll('a').forEach(function (a) {
    const texto = (a.textContent || '').trim().replace(/\s+/g, ' ');
    Object.keys(rutas).forEach(function (clave) {
      if (texto === clave || texto.includes(clave)) {
        a.setAttribute('href', rutas[clave]);
      }
    });
  });

  document.querySelectorAll('button').forEach(function (b) {
    const texto = (b.textContent || '').trim().replace(/\s+/g, ' ');
    if (texto.includes('Iniciar sesión')) b.onclick = function () { location.href = '/Home/Dashboard'; };
    if (texto.includes('Nueva Venta')) b.onclick = function () { location.href = '/Home/Ventas'; };
    if (texto.includes('Solicitar Cotización')) b.onclick = function () { location.href = '/Home/Compras'; };
    if (texto.includes('Exportar Reporte')) b.onclick = function () { location.href = '/Home/Reportes'; };
  });
})();
</script>

</body></html>
