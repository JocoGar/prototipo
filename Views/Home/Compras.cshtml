@{
    ViewData["Title"] = "Compras e Inteligencia de Precios";
}

<section class="mb-6">
    <div class="flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Compras e Inteligencia de Precios</h1>
            <p class="mt-1 text-sm text-slate-500">
                Comparativo histórico para detectar mejores precios, proveedores y momentos de reabastecimiento.
            </p>
        </div>

        <button class="rounded-xl bg-emerald-900 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-800">
            Solicitar cotización
        </button>
    </div>
</section>

<section class="rounded-2xl border border-emerald-100 bg-emerald-50 p-5">
    <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
        <div>
            <p class="text-sm font-semibold text-emerald-800">Oportunidad de compra detectada</p>
            <h2 class="mt-1 text-xl font-bold text-slate-900">Frijol negro 12% debajo del promedio histórico</h2>
            <p class="mt-1 text-sm text-slate-600">
                Proveedor sugerido: AgroInsumos S.A. · Promedio 6 meses: Q 16,200 · Precio actual: Q 14,500.
            </p>
        </div>

        <span class="rounded-xl bg-white px-4 py-2 text-sm font-bold text-emerald-800 border border-emerald-100">
            Confianza 75%
        </span>
    </div>
</section>

<section class="mt-6 grid gap-4 md:grid-cols-4">
    <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-medium text-slate-500">Precio actual</p>
        <h2 class="mt-2 text-2xl font-bold text-slate-900">Q 14,500</h2>
        <p class="mt-2 text-xs text-emerald-700">-2.4% vs mes anterior</p>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-medium text-slate-500">Promedio 6 meses</p>
        <h2 class="mt-2 text-2xl font-bold text-slate-900">Q 16,200</h2>
        <p class="mt-2 text-xs text-slate-500">Base histórica interna</p>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-medium text-slate-500">Mejor proveedor</p>
        <h2 class="mt-2 text-xl font-bold text-slate-900">AgroInsumos S.A.</h2>
        <p class="mt-2 text-xs text-slate-500">Precio más competitivo</p>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-medium text-slate-500">Stock afectado</p>
        <h2 class="mt-2 text-2xl font-bold text-amber-600">8 productos</h2>
        <p class="mt-2 text-xs text-slate-500">Requieren reabastecimiento</p>
    </div>
</section>

<section class="mt-6 rounded-2xl border border-slate-200 bg-white">
    <div class="border-b border-slate-200 p-5">
        <h3 class="font-bold text-slate-900">Comparativo de proveedores</h3>
        <p class="text-sm text-slate-500">Producto seleccionado: Frijol negro grado A.</p>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
            <thead class="bg-slate-50 text-xs uppercase text-slate-500">
                <tr>
                    <th class="px-5 py-3">Proveedor</th>
                    <th class="px-5 py-3">País</th>
                    <th class="px-5 py-3">Último precio</th>
                    <th class="px-5 py-3">Diferencia</th>
                    <th class="px-5 py-3 text-right">Acción</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                <tr>
                    <td class="px-5 py-3 font-medium">AgroInsumos S.A.</td>
                    <td class="px-5 py-3 text-slate-600">México</td>
                    <td class="px-5 py-3">Q 14,500</td>
                    <td class="px-5 py-3">
                        <span class="rounded-full bg-emerald-50 px-2 py-1 text-xs font-semibold text-emerald-700">12% menor</span>
                    </td>
                    <td class="px-5 py-3 text-right">
                        <button class="font-semibold text-emerald-800 hover:underline">Cotizar</button>
                    </td>
                </tr>

                <tr>
                    <td class="px-5 py-3 font-medium">Distribuidora Central</td>
                    <td class="px-5 py-3 text-slate-600">EE.UU.</td>
                    <td class="px-5 py-3">Q 16,000</td>
                    <td class="px-5 py-3">
                        <span class="rounded-full bg-slate-100 px-2 py-1 text-xs font-semibold text-slate-600">1.2% menor</span>
                    </td>
                    <td class="px-5 py-3 text-right">
                        <button class="font-semibold text-emerald-800 hover:underline">Cotizar</button>
                    </td>
                </tr>

                <tr>
                    <td class="px-5 py-3 font-medium">Granos del Mundo</td>
                    <td class="px-5 py-3 text-slate-600">Brasil</td>
                    <td class="px-5 py-3">Q 16,800</td>
                    <td class="px-5 py-3">
                        <span class="rounded-full bg-red-50 px-2 py-1 text-xs font-semibold text-red-700">3.7% mayor</span>
                    </td>
                    <td class="px-5 py-3 text-right">
                        <button class="font-semibold text-emerald-800 hover:underline">Cotizar</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</section>