@{
    ViewData["Title"] = "Centro de Alertas";
}

<section class="mb-6">
    <div class="flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Centro de Alertas</h1>
            <p class="mt-1 text-sm text-slate-500">
                Alertas operativas por vencimiento, stock mínimo, morosidad y eventos críticos.
            </p>
        </div>

        <button class="rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50">
            Filtrar alertas
        </button>
    </div>
</section>

<section class="grid gap-4 md:grid-cols-3">
    <div class="rounded-2xl border border-red-100 bg-red-50 p-5">
        <p class="text-sm font-medium text-red-700">Críticas</p>
        <h2 class="mt-2 text-2xl font-bold text-red-700">12</h2>
        <p class="mt-2 text-xs text-red-600">Lotes próximos a vencer</p>
    </div>

    <div class="rounded-2xl border border-amber-100 bg-amber-50 p-5">
        <p class="text-sm font-medium text-amber-700">Preventivas</p>
        <h2 class="mt-2 text-2xl font-bold text-amber-700">8</h2>
        <p class="mt-2 text-xs text-amber-600">Productos bajo mínimo</p>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-medium text-slate-500">Financieras</p>
        <h2 class="mt-2 text-2xl font-bold text-slate-900">5</h2>
        <p class="mt-2 text-xs text-slate-500">Facturas vencidas</p>
    </div>
</section>

<section class="mt-6 rounded-2xl border border-slate-200 bg-white">
    <div class="border-b border-slate-200 p-5">
        <h3 class="font-bold text-slate-900">Alertas activas</h3>
        <p class="text-sm text-slate-500">Lista priorizada para atención operativa.</p>
    </div>

    <div class="divide-y divide-slate-100">
        <div class="flex flex-col gap-3 p-5 md:flex-row md:items-center md:justify-between">
            <div>
                <span class="rounded-full bg-red-50 px-2 py-1 text-xs font-semibold text-red-700">Crítico</span>
                <h4 class="mt-2 font-bold text-slate-900">Lote L-2394 próximo a expirar</h4>
                <p class="text-sm text-slate-500">Frijol negro · 450 packs de 100 lb · vence en 3 días.</p>
            </div>
            <a asp-action="DetalleLote" class="rounded-xl border border-slate-200 px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50">
                Ver detalle
            </a>
        </div>

        <div class="flex flex-col gap-3 p-5 md:flex-row md:items-center md:justify-between">
            <div>
                <span class="rounded-full bg-amber-50 px-2 py-1 text-xs font-semibold text-amber-700">Preventivo</span>
                <h4 class="mt-2 font-bold text-slate-900">Stock mínimo alcanzado</h4>
                <p class="text-sm text-slate-500">Harina de trigo · stock actual 25 packs de 100 lb · mínimo 50 packs.</p>
            </div>
            <a asp-action="Compras" class="rounded-xl border border-slate-200 px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50">
                Reordenar
            </a>
        </div>

        <div class="flex flex-col gap-3 p-5 md:flex-row md:items-center md:justify-between">
            <div>
                <span class="rounded-full bg-slate-100 px-2 py-1 text-xs font-semibold text-slate-600">Cobranza</span>
                <h4 class="mt-2 font-bold text-slate-900">Factura FAC-8921 vencida</h4>
                <p class="text-sm text-slate-500">Cliente Supermercados del Valle · Q 12,450 · 15 días de atraso.</p>
            </div>
            <a asp-action="Contabilidad" class="rounded-xl border border-slate-200 px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50">
                Cobrar
            </a>
        </div>
    </div>
</section>