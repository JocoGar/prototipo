@{
    ViewData["Title"] = "Gerencia BI";
}

<section class="mb-6">
    <div class="flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Gerencia BI</h1>
            <p class="mt-1 text-sm text-slate-500">
                Indicadores estratégicos para analizar ventas, compras, inventario, vencimientos y rentabilidad.
            </p>
        </div>

        <a asp-action="Reportes" class="rounded-xl bg-emerald-900 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-800">
            Generar reporte
        </a>
    </div>
</section>

<section class="grid gap-4 md:grid-cols-4">
    <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-medium text-slate-500">Ingresos mensuales</p>
        <h2 class="mt-2 text-2xl font-bold text-slate-900">Q 1.8M</h2>
        <p class="mt-2 text-xs text-emerald-700">+8.4% vs mes anterior</p>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-medium text-slate-500">Margen estimado</p>
        <h2 class="mt-2 text-2xl font-bold text-slate-900">22%</h2>
        <p class="mt-2 text-xs text-slate-500">Según precio de compra y venta</p>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-medium text-slate-500">Pérdida evitada</p>
        <h2 class="mt-2 text-2xl font-bold text-emerald-700">Q 35,400</h2>
        <p class="mt-2 text-xs text-slate-500">Por alertas de vencimiento</p>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-medium text-slate-500">Productos críticos</p>
        <h2 class="mt-2 text-2xl font-bold text-red-600">20</h2>
        <p class="mt-2 text-xs text-slate-500">Vencimiento o stock bajo</p>
    </div>
</section>

<section class="mt-6 grid gap-4 xl:grid-cols-2">
    <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="font-bold text-slate-900">Comportamiento de ventas</h3>
        <p class="mt-1 text-sm text-slate-500">Tendencia mensual por sucursal.</p>

        <div class="mt-5 space-y-4">
            <div>
                <div class="mb-1 flex justify-between text-sm">
                    <span>San Lucas</span>
                    <span class="font-semibold">Q 980,000</span>
                </div>
                <div class="h-3 rounded-full bg-slate-100">
                    <div class="h-3 w-[75%] rounded-full bg-emerald-800"></div>
                </div>
            </div>

            <div>
                <div class="mb-1 flex justify-between text-sm">
                    <span>Antigua Guatemala</span>
                    <span class="font-semibold">Q 820,000</span>
                </div>
                <div class="h-3 rounded-full bg-slate-100">
                    <div class="h-3 w-[62%] rounded-full bg-emerald-600"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="font-bold text-slate-900">Decisiones sugeridas</h3>

        <div class="mt-4 space-y-3">
            <div class="rounded-xl bg-emerald-50 p-4">
                <p class="text-sm font-semibold text-emerald-800">Comprar frijol negro esta semana</p>
                <p class="mt-1 text-sm text-slate-600">Precio 12% debajo del promedio de 6 meses.</p>
            </div>

            <div class="rounded-xl bg-amber-50 p-4">
                <p class="text-sm font-semibold text-amber-800">Crear promoción para lotes próximos a vencer</p>
                <p class="mt-1 text-sm text-slate-600">12 lotes requieren rotación inmediata.</p>
            </div>

            <div class="rounded-xl bg-slate-50 p-4">
                <p class="text-sm font-semibold text-slate-800">Revisar cartera morosa</p>
                <p class="mt-1 text-sm text-slate-600">Q 342,500 con impacto en flujo de caja.</p>
            </div>
        </div>
    </div>
</section>