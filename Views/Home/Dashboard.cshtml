@{
    ViewData["Title"] = "Dashboard General";
}

<section class="mb-6">
    <div class="flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Dashboard General</h1>
            <p class="mt-1 text-sm text-slate-500">
                Vista consolidada de ventas, inventario, cobranza, alertas y reportes gerenciales.
            </p>
        </div>

        <div class="flex flex-wrap gap-2">
            <a asp-action="Reportes" class="rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50">
                Exportar reporte
            </a>
            <a asp-action="GerenciaBI" class="rounded-xl bg-emerald-900 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-800">
                Ver BI gerencial
            </a>
        </div>
    </div>
</section>

<section class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
    <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-medium text-slate-500">Ventas del día</p>
        <h2 class="mt-2 text-2xl font-bold text-slate-900">Q 48,250</h2>
        <p class="mt-2 text-xs text-emerald-700">San Lucas + Antigua Guatemala</p>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-medium text-slate-500">Lotes próximos a vencer</p>
        <h2 class="mt-2 text-2xl font-bold text-red-600">12</h2>
        <p class="mt-2 text-xs text-slate-500">Prioridad para bodega y marketing</p>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-medium text-slate-500">Productos bajo mínimo</p>
        <h2 class="mt-2 text-2xl font-bold text-amber-600">8</h2>
        <p class="mt-2 text-xs text-slate-500">Alertas automáticas para compras</p>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-medium text-slate-500">Cartera en mora</p>
        <h2 class="mt-2 text-2xl font-bold text-slate-900">Q 342,500</h2>
        <p class="mt-2 text-xs text-red-600">Bloqueo automático de ventas</p>
    </div>
</section>

<section class="mt-6 grid gap-4 xl:grid-cols-3">
    <div class="rounded-2xl border border-slate-200 bg-white p-5 xl:col-span-2">
        <div class="mb-4">
            <h3 class="font-bold text-slate-900">Procesos principales del sistema</h3>
            <p class="text-sm text-slate-500">
                Flujo integrado basado en ventas, inventario, cobranza, seguridad, importación y reportes.
            </p>
        </div>

        <div class="grid gap-3 md:grid-cols-3">
            <div class="rounded-xl bg-slate-50 p-4">
                <span class="material-symbols-outlined text-emerald-900">point_of_sale</span>
                <h4 class="mt-2 font-semibold">Ventas y FEL</h4>
                <p class="mt-1 text-sm text-slate-500">
                    Registro de cliente, validación de morosidad y facturación electrónica.
                </p>
            </div>

            <div class="rounded-xl bg-slate-50 p-4">
                <span class="material-symbols-outlined text-emerald-900">inventory_2</span>
                <h4 class="mt-2 font-semibold">Inventario por lote</h4>
                <p class="mt-1 text-sm text-slate-500">
                    Control de existencias, bodegas, vida útil y fechas de vencimiento.
                </p>
            </div>

            <div class="rounded-xl bg-slate-50 p-4">
                <span class="material-symbols-outlined text-emerald-900">monitoring</span>
                <h4 class="mt-2 font-semibold">BI y reportes</h4>
                <p class="mt-1 text-sm text-slate-500">
                    Comparativos históricos, temporadas de demanda y oportunidades de compra.
                </p>
            </div>
        </div>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="font-bold text-slate-900">Alertas recientes</h3>

        <div class="mt-4 space-y-3">
            <div class="rounded-xl border border-red-100 bg-red-50 p-3">
                <p class="text-sm font-semibold text-red-700">Lote L-2394 vence en 3 días</p>
                <p class="text-xs text-red-600">Frijol negro · Bodega San Lucas</p>
            </div>

            <div class="rounded-xl border border-amber-100 bg-amber-50 p-3">
                <p class="text-sm font-semibold text-amber-700">Harina bajo nivel mínimo</p>
                <p class="text-xs text-amber-600">Stock actual: 25 kg · mínimo: 50 kg</p>
            </div>

            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
                <p class="text-sm font-semibold text-slate-700">Factura FAC-8921 vencida</p>
                <p class="text-xs text-slate-500">Cliente requiere seguimiento de cobranza</p>
            </div>
        </div>
    </div>
</section>