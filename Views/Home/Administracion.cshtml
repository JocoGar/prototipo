@{
    ViewData["Title"] = "Administración del Sistema";
}

<section class="mb-6">
    <div class="flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Administración del Sistema</h1>
            <p class="mt-1 text-sm text-slate-500">
                Gestión de usuarios, roles, permisos, importación de datos y auditoría.
            </p>
        </div>

        <button class="rounded-xl bg-emerald-900 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-800">
            Nuevo usuario
        </button>
    </div>
</section>

<section class="grid gap-4 md:grid-cols-4">
    <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-medium text-slate-500">Usuarios activos</p>
        <h2 class="mt-2 text-2xl font-bold text-slate-900">42</h2>
        <p class="mt-2 text-xs text-slate-500">Acceso por rol</p>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-medium text-slate-500">Roles configurados</p>
        <h2 class="mt-2 text-2xl font-bold text-slate-900">8</h2>
        <p class="mt-2 text-xs text-slate-500">Ventas, bodega, gerencia, etc.</p>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-medium text-slate-500">Importaciones</p>
        <h2 class="mt-2 text-2xl font-bold text-emerald-700">15</h2>
        <p class="mt-2 text-xs text-slate-500">Desde Excel/CSV</p>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-medium text-slate-500">Eventos auditados</p>
        <h2 class="mt-2 text-2xl font-bold text-slate-900">1,284</h2>
        <p class="mt-2 text-xs text-slate-500">Bitácora de actividad</p>
    </div>
</section>

<section class="mt-6 grid gap-4 xl:grid-cols-3">
    <div class="rounded-2xl border border-slate-200 bg-white xl:col-span-2">
        <div class="border-b border-slate-200 p-5">
            <h3 class="font-bold text-slate-900">Usuarios del sistema</h3>
            <p class="text-sm text-slate-500">Accesos según rol operativo.</p>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead class="bg-slate-50 text-xs uppercase text-slate-500">
                    <tr>
                        <th class="px-5 py-3">Usuario</th>
                        <th class="px-5 py-3">Rol</th>
                        <th class="px-5 py-3">Estado</th>
                        <th class="px-5 py-3 text-right">Acción</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    <tr>
                        <td class="px-5 py-3 font-medium">Carlos Mendoza</td>
                        <td class="px-5 py-3 text-slate-600">Asesor de ventas</td>
                        <td class="px-5 py-3">
                            <span class="rounded-full bg-emerald-50 px-2 py-1 text-xs font-semibold text-emerald-700">Activo</span>
                        </td>
                        <td class="px-5 py-3 text-right">
                            <button class="font-semibold text-emerald-800 hover:underline">Editar</button>
                        </td>
                    </tr>

                    <tr>
                        <td class="px-5 py-3 font-medium">Ana Torres</td>
                        <td class="px-5 py-3 text-slate-600">Supervisor de bodega</td>
                        <td class="px-5 py-3">
                            <span class="rounded-full bg-emerald-50 px-2 py-1 text-xs font-semibold text-emerald-700">Activo</span>
                        </td>
                        <td class="px-5 py-3 text-right">
                            <button class="font-semibold text-emerald-800 hover:underline">Editar</button>
                        </td>
                    </tr>

                    <tr>
                        <td class="px-5 py-3 font-medium">Luis Gómez</td>
                        <td class="px-5 py-3 text-slate-600">Contabilidad</td>
                        <td class="px-5 py-3">
                            <span class="rounded-full bg-slate-100 px-2 py-1 text-xs font-semibold text-slate-600">Inactivo</span>
                        </td>
                        <td class="px-5 py-3 text-right">
                            <button class="font-semibold text-emerald-800 hover:underline">Activar</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="font-bold text-slate-900">Importación de datos</h3>
        <p class="mt-1 text-sm text-slate-500">
            Carga controlada de plantillas desde Excel para migración y operación.
        </p>

        <div class="mt-4 space-y-3">
            <select class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm outline-none focus:border-emerald-700">
                <option>Inventario y lotes</option>
                <option>Clientes</option>
                <option>Productos</option>
                <option>Historial de compras</option>
            </select>

            <div class="flex h-32 items-center justify-center rounded-xl border-2 border-dashed border-slate-300 bg-slate-50 text-center text-sm text-slate-500">
                Arrastre archivo .xlsx o .csv
            </div>

            <button class="w-full rounded-xl border border-slate-200 px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50">
                Validar archivo
            </button>
        </div>
    </div>
</section>