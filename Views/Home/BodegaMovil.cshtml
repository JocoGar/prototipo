@{
    Layout = null;
}
<!-- Bodeguero (Móvil) -->
<!DOCTYPE html><html lang="es"><head>
<meta charset="utf-8">
<meta content="width=device-width, initial-scale=1.0" name="viewport">
<title>Comercializadora San Juan - Bodega Móvil</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@@400;500;600;700;900&amp;display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@@100..700,0..1&amp;display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@@100..700,0..1&amp;display=swap" rel="stylesheet">
<script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            "colors": {
                    "on-primary-fixed-variant": "#0c5216",
                    "on-primary-fixed": "#002203",
                    "on-tertiary-fixed": "#2c1600",
                    "inverse-surface": "#2f3131",
                    "secondary-container": "#759efd",
                    "tertiary-fixed": "#ffdcbe",
                    "surface": "#f9f9f9",
                    "surface-container-high": "#e8e8e8",
                    "tertiary": "#583100",
                    "secondary-fixed-dim": "#b0c6ff",
                    "surface-bright": "#f9f9f9",
                    "on-secondary-fixed-variant": "#00429c",
                    "primary-fixed": "#acf4a4",
                    "on-surface": "#1a1c1c",
                    "error": "#ba1a1a",
                    "secondary": "#2b5bb5",
                    "surface-container-lowest": "#ffffff",
                    "surface-container": "#eeeeee",
                    "background": "#f9f9f9",
                    "primary": "#00450d",
                    "error-container": "#ffdad6",
                    "secondary-fixed": "#d9e2ff",
                    "surface-dim": "#dadada",
                    "surface-tint": "#2a6b2c",
                    "on-background": "#1a1c1c",
                    "on-secondary-container": "#00337c",
                    "inverse-primary": "#91d78a",
                    "surface-container-low": "#f3f3f3",
                    "surface-variant": "#e2e2e2",
                    "on-primary": "#ffffff",
                    "on-tertiary": "#ffffff",
                    "on-secondary-fixed": "#001945",
                    "on-tertiary-container": "#ffb66b",
                    "outline": "#717a6d",
                    "on-error-container": "#93000a",
                    "on-error": "#ffffff",
                    "tertiary-fixed-dim": "#ffb870",
                    "outline-variant": "#c0c9bb",
                    "primary-fixed-dim": "#91d78a",
                    "inverse-on-surface": "#f1f1f1",
                    "on-tertiary-fixed-variant": "#693c00",
                    "on-secondary": "#ffffff",
                    "on-surface-variant": "#41493e",
                    "on-primary-container": "#90d689",
                    "primary-container": "#1b5e20",
                    "surface-container-highest": "#e2e2e2",
                    "tertiary-container": "#794500"
            },
            "borderRadius": {
                    "DEFAULT": "0.125rem",
                    "lg": "0.25rem",
                    "xl": "0.5rem",
                    "full": "0.75rem"
            },
            "spacing": {
                    "lg": "24px",
                    "margin-mobile": "16px",
                    "xl": "32px",
                    "xs": "4px",
                    "sidebar-width": "260px",
                    "margin-desktop": "32px",
                    "md": "16px",
                    "base": "8px",
                    "gutter": "16px",
                    "sm": "8px"
            },
            "fontFamily": {
                    "display-lg": ["Inter"],
                    "headline-lg": ["Inter"],
                    "code-md": ["monospace"],
                    "label-md": ["Inter"],
                    "headline-md": ["Inter"],
