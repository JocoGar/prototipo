                    "headline-lg-mobile": ["Inter"],
                    "title-lg": ["Inter"]
            },
            "fontSize": {
                    "display-lg": ["48px", { "lineHeight": "56px", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                    "headline-lg": ["32px", { "lineHeight": "40px", "fontWeight": "600" }],
                    "code-md": ["13px", { "lineHeight": "18px", "fontWeight": "400" }],
                    "label-md": ["12px", { "lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "500" }],
                    "headline-md": ["24px", { "lineHeight": "32px", "fontWeight": "600" }],
                    "body-md": ["14px", { "lineHeight": "20px", "fontWeight": "400" }],
                    "body-lg": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
                    "headline-lg-mobile": ["24px", { "lineHeight": "32px", "fontWeight": "600" }],
                    "title-lg": ["20px", { "lineHeight": "28px", "fontWeight": "600" }]
            }
          }
        }
      }
    </script>
<style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .material-symbols-outlined.filled {
            font-variation-settings: 'FILL' 1;
        }
        /* Mobile specific styles for full height */
        html, body {
            height: 100%;
            background-color: #f9f9f9; /* bg-background */
        }
    </style>
<style>
    body {
      min-height: max(884px, 100dvh);
    }
  </style>
  </head>
<body class="font-body-md text-on-surface bg-background flex flex-col antialiased">
<!-- Top Navigation Bar (Mobile focused) -->
<header class="bg-primary text-on-primary sticky top-0 z-50 shadow-md">
<div class="flex justify-between items-center h-16 px-margin-mobile">
<div class="flex items-center gap-md">
<button aria-label="Menu" class="p-sm rounded-full hover:bg-primary-container transition-colors">
<span class="material-symbols-outlined text-on-primary">menu</span>
</button>
<div class="flex flex-col">
<span class="font-title-lg text-title-lg font-bold text-on-primary">Bodega</span>
<span class="font-label-md text-label-md text-primary-fixed-dim">Turno Mañana</span>
</div>
</div>
<div class="flex items-center gap-md">
<button aria-label="Notificaciones" class="relative p-sm rounded-full hover:bg-primary-container transition-colors">
<span class="material-symbols-outlined text-on-primary">notifications</span>
<span class="absolute top-1 right-1 w-2.5 h-2.5 bg-error rounded-full border-2 border-primary"></span>
</button>
</div>
</div>
</header>
<!-- Main Content Canvas -->
<main class="flex-grow flex flex-col p-margin-mobile gap-lg overflow-y-auto pb-24">
<!-- Welcome / Quick Stats -->
<section class="flex flex-col gap-base">
<h1 class="font-headline-lg-mobile text-headline-lg-mobile text-on-surface">Hola, Carlos</h1>
<p class="font-body-md text-body-md text-on-surface-variant">¿Qué haremos hoy?</p>
<div class="grid grid-cols-2 gap-sm mt-sm">
<div class="bg-surface-container-low p-md rounded-xl border border-outline-variant shadow-sm flex flex-col gap-xs">
<span class="font-label-md text-label-md text-on-surface-variant uppercase">Despachos Hoy</span>
<span class="font-headline-md text-headline-md text-primary font-bold">12</span>
</div>
<div class="bg-surface-container-low p-md rounded-xl border border-outline-variant shadow-sm flex flex-col gap-xs">
<span class="font-label-md text-label-md text-on-surface-variant uppercase">Pendientes</span>
<span class="font-headline-md text-headline-md text-error font-bold">5</span>
</div>
</div>
</section>
<!-- Quick Actions (High Contrast, Large Buttons) -->
<section class="flex flex-col gap-md">
<h2 class="font-title-lg text-title-lg text-on-surface font-semibold mb-xs">Acciones Rápidas</h2>
<button class="w-full bg-primary-container text-on-primary-container p-lg rounded-xl flex items-center justify-between shadow-sm active:scale-[0.98] transition-transform" onclick="toggleView('registrarSalidaView')">
<div class="flex items-center gap-md">
<div class="w-12 h-12 rounded-full bg-on-primary-container/10 flex items-center justify-center">
<span class="material-symbols-outlined filled text-2xl">local_shipping</span>
</div>
<div class="flex flex-col items-start">
<span class="font-title-lg text-title-lg font-bold">Registrar Salida</span>
<span class="font-body-md text-body-md text-on-primary-container/80">Escanear y despachar</span>
</div>
</div>
<span class="material-symbols-outlined">chevron_right</span>
</button>
<button class="w-full bg-surface-container-highest text-on-surface p-lg rounded-xl flex items-center justify-between shadow-sm active:scale-[0.98] border border-outline-variant transition-transform">
<div class="flex items-center gap-md">
<div class="w-12 h-12 rounded-full bg-secondary-container/20 flex items-center justify-center">
<span class="material-symbols-outlined text-secondary text-2xl">inventory</span>
</div>
<div class="flex flex-col items-start">
<span class="font-title-lg text-title-lg font-bold">Consultar Lote</span>
<span class="font-body-md text-body-md text-on-surface-variant">Revisar stock y caducidad</span>
</div>
</div>
<span class="material-symbols-outlined text-on-surface-variant">chevron_right</span>
</button>
<button class="w-full bg-surface-container-highest text-on-surface p-lg rounded-xl flex items-center justify-between shadow-sm active:scale-[0.98] border border-outline-variant transition-transform">
<div class="flex items-center gap-md">
<div class="w-12 h-12 rounded-full bg-error-container/20 flex items-center justify-center">
<span class="material-symbols-outlined text-error text-2xl">pending_actions</span>
</div>
<div class="flex flex-col items-start">
<span class="font-title-lg text-title-lg font-bold">Despachos Pendientes</span>
<span class="font-body-md text-body-md text-on-surface-variant">5 órdenes en espera</span>
</div>
</div>
<span class="material-symbols-outlined text-on-surface-variant">chevron_right</span>
</button>
</section>
</main>
<!-- Modal / Overlay View: Registrar Salida Flow -->
<div class="fixed inset-0 bg-background z-[60] flex-col hidden overflow-hidden" id="registrarSalidaView">
<!-- Header -->
<header class="bg-surface text-on-surface sticky top-0 z-50 border-b border-outline-variant flex justify-between items-center h-16 px-margin-mobile">
<button aria-label="Cerrar" class="p-sm rounded-full hover:bg-surface-container-highest transition-colors" onclick="toggleView('registrarSalidaView')">
<span class="material-symbols-outlined">close</span>
</button>
<span class="font-title-lg text-title-lg font-bold">Registrar Salida</span>
<div class="w-10"></div> <!-- spacer for centering -->
</header>
<div class="flex-grow overflow-y-auto p-margin-mobile flex flex-col gap-lg pb-32">
<!-- Step 1: Escaneo -->
<section class="flex flex-col gap-sm">
<label class="font-label-md text-label-md text-on-surface-variant uppercase font-bold">1. Orden de Venta</label>
<div class="flex gap-sm">
<div class="relative flex-grow">
<span class="material-symbols-outlined absolute left-md top-1/2 -translate-y-1/2 text-on-surface-variant">search</span>
<input class="w-full pl-12 pr-md py-3 rounded-lg border border-outline bg-surface focus:border-secondary focus:ring-1 focus:ring-secondary outline-none font-body-lg text-body-lg text-on-surface placeholder:text-on-surface-variant/50 transition-shadow" placeholder="ID de Venta o Escanear..." type="text">
</div>
<button aria-label="Escanear Código de Barras" class="bg-secondary text-on-secondary px-md rounded-lg flex items-center justify-center active:scale-95 transition-transform">
<span class="material-symbols-outlined">barcode_scanner</span>
</button>
</div>
<!-- Simulated selected order -->
<div class="mt-sm bg-surface-container-low border border-primary-fixed rounded-lg p-md flex flex-col gap-xs">
<div class="flex justify-between items-center">
<span class="font-title-lg text-title-lg font-bold text-on-surface">VTA-2023-0891</span>
<span class="bg-primary-container text-on-primary-container px-2 py-1 rounded-full font-label-md text-label-md">Confirmada</span>
</div>
<span class="font-body-md text-body-md text-on-surface-variant">Cliente: Supermercados del Norte</span>
</div>
</section>
<!-- Step 2: Selección de Lote y Cantidad -->
<section class="flex flex-col gap-sm">
<label class="font-label-md text-label-md text-on-surface-variant uppercase font-bold">2. Detalle de Despacho</label>
<div class="bg-surface border border-outline-variant rounded-lg p-md flex flex-col gap-md">
<div class="flex flex-col">
<span class="font-body-lg text-body-lg font-bold text-on-surface mb-xs">Manzanas Rojas Premium (Caja 10kg)</span>
<span class="font-body-md text-body-md text-on-surface-variant">Requerido: 50 cajas</span>
</div>
<div class="flex flex-col gap-xs">
<label class="font-label-md text-label-md text-on-surface">Lote a despachar</label>
<select class="w-full p-3 rounded-lg border border-outline bg-surface focus:border-secondary focus:ring-1 focus:ring-secondary outline-none font-body-lg text-body-lg text-on-surface appearance-none">
<option value="">Seleccionar Lote...</option>
<option value="L-001">Lote L-001 (Cad: 15/Nov) - Stock: 120</option>
<option value="L-002">Lote L-002 (Cad: 20/Nov) - Stock: 80</option>
</select>
</div>
<div class="flex flex-col gap-xs">
<label class="font-label-md text-label-md text-on-surface">Cantidad a despachar</label>
<div class="flex items-center gap-md">
<button class="w-12 h-12 rounded-full bg-surface-container-highest flex items-center justify-center border border-outline-variant active:bg-surface-variant">
<span class="material-symbols-outlined">remove</span>
</button>
<input class="flex-grow text-center py-3 rounded-lg border border-outline bg-surface focus:border-secondary focus:ring-1 focus:ring-secondary outline-none font-headline-md text-headline-md font-bold text-on-surface" type="number" value="50">
<button class="w-12 h-12 rounded-full bg-surface-container-highest flex items-center justify-center border border-outline-variant active:bg-surface-variant">
<span class="material-symbols-outlined">add</span>
</button>
</div>
</div>
</div>
</section>
<!-- Step 3: Firma Digital -->
<section class="flex flex-col gap-sm">
<label class="font-label-md text-label-md text-on-surface-variant uppercase font-bold">3. Confirmación (Firma Chofer)</label>
<div class="border-2 border-dashed border-outline-variant rounded-lg h-32 bg-surface-container-lowest flex items-center justify-center relative">
<span class="font-body-md text-body-md text-on-surface-variant/50 pointer-events-none absolute">Firmar aquí</span>
<!-- Placeholder for canvas -->
</div>
<div class="flex justify-end">
<button class="font-label-md text-label-md text-secondary uppercase hover:underline">Limpiar Firma</button>
</div>
</section>
</div>
<!-- Sticky Bottom Action -->
<div class="fixed bottom-0 left-0 right-0 p-margin-mobile bg-surface border-t border-outline-variant shadow-[0_-4px_6px_-1px_rgba(0,0,0,0.05)] z-50">
<button class="w-full bg-primary text-on-primary font-title-lg text-title-lg font-bold py-4 rounded-xl flex items-center justify-center gap-sm active:scale-[0.98] transition-transform" onclick="showSuccess()">
<span class="material-symbols-outlined filled">check_circle</span>
                Confirmar Despacho
            </button>
</div>
</div>
<!-- Success Toast Notification (Hidden by default) -->
<div class="fixed top-4 left-4 right-4 bg-primary-container text-on-primary-container p-md rounded-lg shadow-lg border border-primary z-[70] flex items-center gap-md transform -translate-y-24 transition-transform duration-300 opacity-0" id="successToast">
<span class="material-symbols-outlined filled text-3xl">check_circle</span>
<div class="flex flex-col">
<span class="font-title-lg text-title-lg font-bold">¡Éxito!</span>
<span class="font-body-md text-body-md">Salida registrada y stock actualizado.</span>
</div>
</div>
<script>
        function toggleView(id) {
            const el = document.getElementById(id);
            if (el.classList.contains('hidden')) {
                el.classList.remove('hidden');
                el.classList.add('flex');
            } else {
                el.classList.add('hidden');
                el.classList.remove('flex');
            }
        }

        function showSuccess() {
            // Hide modal
            toggleView('registrarSalidaView');
            
            // Show toast
            const toast = document.getElementById('successToast');
            toast.classList.remove('-translate-y-24', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');
            
            // Hide toast after 3 seconds
            setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('-translate-y-24', 'opacity-0');
            }, 3000);
        }
    </script>

<script>
(function () {
  const rutas = {
    "Dashboard": "/Home/Dashboard",
    "BI Gerencial": "/Home/GerenciaBI",
    "Compras": "/Home/Compras",
    "Marketing": "/Home/Marketing",
    "Contabilidad": "/Home/Contabilidad",
    "Ventas": "/Home/Ventas",
    "Inventario": "/Home/SupervisorBodega",
    "Alertas": "/Home/Alertas",
    "Reportes": "/Home/Reportes",
    "Usuarios": "/Home/Administracion"
  };

  document.querySelectorAll('a').forEach(function (a) {
    const texto = (a.textContent || '').trim().replace(/\s+/g, ' ');
    Object.keys(rutas).forEach(function (clave) {
      if (texto === clave || texto.includes(clave)) {
        a.setAttribute('href', rutas[clave]);
      }
    });
  });

  document.querySelectorAll('button').forEach(function (b) {
    const texto = (b.textContent || '').trim().replace(/\s+/g, ' ');
    if (texto.includes('Iniciar sesión')) b.onclick = function () { location.href = '/Home/Dashboard'; };
    if (texto.includes('Nueva Venta')) b.onclick = function () { location.href = '/Home/Ventas'; };
    if (texto.includes('Solicitar Cotización')) b.onclick = function () { location.href = '/Home/Compras'; };
    if (texto.includes('Exportar Reporte')) b.onclick = function () { location.href = '/Home/Reportes'; };
  });
})();
</script>

</body></html>
