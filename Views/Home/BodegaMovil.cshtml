@{
    ViewData["Title"] = "Bodega Móvil";
}

<section class="mb-6">
    <div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-900">Bodega Móvil</h1>
        <p class="mt-1 text-sm text-slate-500">
            Registro rápido de salidas de mercadería desde tablet o dispositivo móvil.
        </p>
    </div>
</section>

<section class="mx-auto max-w-xl">
    <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-sm text-slate-500">Turno actual</p>
                <h2 class="text-xl font-bold text-slate-900">Bodega San Lucas</h2>
            </div>
            <div class="rounded-2xl bg-emerald-50 px-3 py-2 text-sm font-bold text-emerald-700">
                Activo
            </div>
        </div>

        <div class="mt-5 grid grid-cols-2 gap-3">
            <div class="rounded-2xl bg-slate-50 p-4">
                <p class="text-xs font-semibold uppercase text-slate-500">Despachos hoy</p>
                <h3 class="mt-2 text-2xl font-bold text-slate-900">12</h3>
            </div>

            <div class="rounded-2xl bg-slate-50 p-4">
                <p class="text-xs font-semibold uppercase text-slate-500">Pendientes</p>
                <h3 class="mt-2 text-2xl font-bold text-red-600">5</h3>
            </div>
        </div>

        <div class="mt-6 space-y-3">
            <button onclick="document.getElementById('salidaPanel').classList.remove('hidden')"
                    class="flex w-full items-center justify-between rounded-2xl bg-emerald-900 p-4 text-left text-white hover:bg-emerald-800">
                <div class="flex items-center gap-3">
                    <span class="material-symbols-outlined">local_shipping</span>
                    <div>
                        <p class="font-bold">Registrar salida</p>
                        <p class="text-sm text-emerald-100">Seleccionar lote, cantidad y firma</p>
                    </div>
                </div>
                <span class="material-symbols-outlined">chevron_right</span>
            </button>

            <a asp-action="SupervisorBodega"
               class="flex w-full items-center justify-between rounded-2xl border border-slate-200 bg-white p-4 text-left hover:bg-slate-50">
                <div class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-emerald-900">inventory</span>
                    <div>
                        <p class="font-bold text-slate-900">Consultar lote</p>
                        <p class="text-sm text-slate-500">Stock, bodega y vencimiento</p>
                    </div>
                </div>
                <span class="material-symbols-outlined text-slate-400">chevron_right</span>
            </a>

            <a asp-action="Alertas"
               class="flex w-full items-center justify-between rounded-2xl border border-slate-200 bg-white p-4 text-left hover:bg-slate-50">
                <div class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-red-600">pending_actions</span>
                    <div>
                        <p class="font-bold text-slate-900">Despachos pendientes</p>
                        <p class="text-sm text-slate-500">5 órdenes en espera</p>
                    </div>
                </div>
                <span class="material-symbols-outlined text-slate-400">chevron_right</span>
            </a>
        </div>
    </div>
</section>

<section id="salidaPanel" class="hidden fixed inset-0 z-50 bg-slate-900/40 p-4">
    <div class="mx-auto mt-8 max-w-xl rounded-3xl bg-white p-5 shadow-xl">
        <div class="flex items-center justify-between border-b border-slate-200 pb-4">
            <h3 class="text-lg font-bold text-slate-900">Registrar salida</h3>
            <button onclick="document.getElementById('salidaPanel').classList.add('hidden')" class="rounded-xl p-2 hover:bg-slate-100">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>

        <div class="mt-5 space-y-4">
            <div>
                <label class="text-sm font-semibold text-slate-700">Orden de venta</label>
                <input class="mt-1 w-full rounded-xl border border-slate-200 px-3 py-2 text-sm outline-none focus:border-emerald-700"
                       placeholder="Ej. VTA-2026-0891" />
            </div>

            <div>
                <label class="text-sm font-semibold text-slate-700">Lote</label>
                <select class="mt-1 w-full rounded-xl border border-slate-200 px-3 py-2 text-sm outline-none focus:border-emerald-700">
                    <option>L-2394 · Frijol negro · Stock 450</option>
                    <option>L-4108 · Arroz blanco · Stock 900</option>
                    <option>L-3110 · Harina de trigo · Stock 25</option>
                </select>
            </div>

            <div>
                <label class="text-sm font-semibold text-slate-700">Cantidad despachada</label>
                <input type="number" value="50"
                       class="mt-1 w-full rounded-xl border border-slate-200 px-3 py-2 text-sm outline-none focus:border-emerald-700" />
            </div>

            <div>
                <label class="text-sm font-semibold text-slate-700">Firma digital del responsable</label>
                <div class="mt-1 flex h-28 items-center justify-center rounded-xl border-2 border-dashed border-slate-300 bg-slate-50 text-sm text-slate-400">
                    Área de firma
                </div>
            </div>

            <button onclick="document.getElementById('salidaPanel').classList.add('hidden')"
                    class="w-full rounded-xl bg-emerald-900 px-4 py-3 text-sm font-bold text-white hover:bg-emerald-800">
                Confirmar despacho
            </button>
        </div>
    </div>
</section>