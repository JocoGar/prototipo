@{
    ViewData["Title"] = "Reportes";
}

<section class="mb-6">
    <div class="flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Reportes</h1>
            <p class="mt-1 text-sm text-slate-500">
                Generación de reportes operativos, financieros y gerenciales en PDF o Excel.
            </p>
        </div>

        <button class="rounded-xl bg-emerald-900 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-800">
            Exportar PDF
        </button>
    </div>
</section>

<section class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
    <a asp-action="Ventas" class="rounded-2xl border border-slate-200 bg-white p-5 hover:bg-slate-50">
        <span class="material-symbols-outlined text-emerald-900">point_of_sale</span>
        <h3 class="mt-3 font-bold text-slate-900">Ventas</h3>
        <p class="mt-1 text-sm text-slate-500">Transacciones por fecha, sucursal, producto y asesor.</p>
    </a>

    <a asp-action="SupervisorBodega" class="rounded-2xl border border-slate-200 bg-white p-5 hover:bg-slate-50">
        <span class="material-symbols-outlined text-emerald-900">inventory_2</span>
        <h3 class="mt-3 font-bold text-slate-900">Inventario</h3>
        <p class="mt-1 text-sm text-slate-500">Existencias por lote, bodega y vencimiento.</p>
    </a>

    <a asp-action="Compras" class="rounded-2xl border border-slate-200 bg-white p-5 hover:bg-slate-50">
        <span class="material-symbols-outlined text-emerald-900">shopping_cart</span>
        <h3 class="mt-3 font-bold text-slate-900">Compras</h3>
        <p class="mt-1 text-sm text-slate-500">Historial de precios y comparativo de proveedores.</p>
    </a>

    <a asp-action="Contabilidad" class="rounded-2xl border border-slate-200 bg-white p-5 hover:bg-slate-50">
        <span class="material-symbols-outlined text-emerald-900">account_balance</span>
        <h3 class="mt-3 font-bold text-slate-900">Cobranza</h3>
        <p class="mt-1 text-sm text-slate-500">Mora, saldos pendientes e ingresos por sucursal.</p>
    </a>
</section>

<section class="mt-6 rounded-2xl border border-slate-200 bg-white p-5">
    <h3 class="font-bold text-slate-900">Generar reporte personalizado</h3>
    <p class="mt-1 text-sm text-slate-500">Seleccione módulo, rango de fechas y formato de salida.</p>

    <div class="mt-5 grid gap-4 md:grid-cols-4">
        <div>
            <label class="text-sm font-semibold text-slate-700">Módulo</label>
            <select class="mt-1 w-full rounded-xl border border-slate-200 px-3 py-2 text-sm outline-none focus:border-emerald-700">
                <option>Ventas</option>
                <option>Inventario</option>
                <option>Compras</option>
                <option>Cobranza</option>
                <option>Vencimientos</option>
            </select>
        </div>

        <div>
            <label class="text-sm font-semibold text-slate-700">Desde</label>
            <input type="date" class="mt-1 w-full rounded-xl border border-slate-200 px-3 py-2 text-sm outline-none focus:border-emerald-700" />
        </div>

        <div>
            <label class="text-sm font-semibold text-slate-700">Hasta</label>
            <input type="date" class="mt-1 w-full rounded-xl border border-slate-200 px-3 py-2 text-sm outline-none focus:border-emerald-700" />
        </div>

        <div>
            <label class="text-sm font-semibold text-slate-700">Formato</label>
            <select class="mt-1 w-full rounded-xl border border-slate-200 px-3 py-2 text-sm outline-none focus:border-emerald-700">
                <option>PDF</option>
                <option>Excel</option>
            </select>
        </div>
    </div>

    <button class="mt-5 rounded-xl bg-emerald-900 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-800">
        Generar reporte
    </button>
</section>