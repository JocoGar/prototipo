@{
    ViewData["Title"] = "Cobranza y Mora";
}

<section class="mb-6">
    <div class="flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Cobranza y Mora</h1>
            <p class="mt-1 text-sm text-slate-500">
                Seguimiento de facturas vencidas, saldos pendientes y recargos automáticos.
            </p>
        </div>

        <button class="rounded-xl bg-emerald-900 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-800">
            Registrar pago
        </button>
    </div>
</section>

<section class="grid gap-4 md:grid-cols-4">
    <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-medium text-slate-500">Total pendiente</p>
        <h2 class="mt-2 text-2xl font-bold text-slate-900">Q 1,245,000</h2>
        <p class="mt-2 text-xs text-slate-500">Cuentas por cobrar</p>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-medium text-slate-500">Mora acumulada</p>
        <h2 class="mt-2 text-2xl font-bold text-red-600">Q 342,500</h2>
        <p class="mt-2 text-xs text-red-600">Clientes con más de 30 días</p>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-medium text-slate-500">Facturas vencidas</p>
        <h2 class="mt-2 text-2xl font-bold text-slate-900">128</h2>
        <p class="mt-2 text-xs text-slate-500">45 clientes afectados</p>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-medium text-slate-500">Pagos recibidos hoy</p>
        <h2 class="mt-2 text-2xl font-bold text-emerald-700">Q 85,200</h2>
        <p class="mt-2 text-xs text-slate-500">12 transacciones</p>
    </div>
</section>

<section class="mt-6 rounded-2xl border border-slate-200 bg-white">
    <div class="border-b border-slate-200 p-5">
        <h3 class="font-bold text-slate-900">Clientes con seguimiento de cobranza</h3>
        <p class="text-sm text-slate-500">Ordenados por prioridad según días de mora.</p>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
            <thead class="bg-slate-50 text-xs uppercase text-slate-500">
                <tr>
                    <th class="px-5 py-3">Cliente</th>
                    <th class="px-5 py-3">Factura</th>
                    <th class="px-5 py-3">Saldo</th>
                    <th class="px-5 py-3">Días mora</th>
                    <th class="px-5 py-3 text-right">Estado</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                <tr>
                    <td class="px-5 py-3 font-medium">Distribuidora El Norte S.A.</td>
                    <td class="px-5 py-3 text-slate-600">FAC-2026-0891</td>
                    <td class="px-5 py-3">Q 45,000</td>
                    <td class="px-5 py-3 text-red-600 font-semibold">45</td>
                    <td class="px-5 py-3 text-right">
                        <span class="rounded-full bg-red-50 px-2 py-1 text-xs font-semibold text-red-700">En mora</span>
                    </td>
                </tr>

                <tr>
                    <td class="px-5 py-3 font-medium">Supermercados La Vega</td>
                    <td class="px-5 py-3 text-slate-600">FAC-2026-0902</td>
                    <td class="px-5 py-3">Q 60,250</td>
                    <td class="px-5 py-3 text-amber-600 font-semibold">12</td>
                    <td class="px-5 py-3 text-right">
                        <span class="rounded-full bg-amber-50 px-2 py-1 text-xs font-semibold text-amber-700">Vencido</span>
                    </td>
                </tr>

                <tr>
                    <td class="px-5 py-3 font-medium">Comercial Los Andes</td>
                    <td class="px-5 py-3 text-slate-600">FAC-2026-0915</td>
                    <td class="px-5 py-3">Q 18,200</td>
                    <td class="px-5 py-3">0</td>
                    <td class="px-5 py-3 text-right">
                        <span class="rounded-full bg-emerald-50 px-2 py-1 text-xs font-semibold text-emerald-700">Al día</span>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</section>