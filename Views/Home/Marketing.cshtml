@{
    ViewData["Title"] = "Marketing";
}

<section class="mb-6">
    <div class="flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Marketing</h1>
            <p class="mt-1 text-sm text-slate-500">
                Planeación de promociones basada en vencimientos, temporadas y comportamiento de ventas.
            </p>
        </div>

        <button class="rounded-xl bg-emerald-900 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-800">
            Crear campaña
        </button>
    </div>
</section>

<section class="grid gap-4 md:grid-cols-3">
    <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-medium text-slate-500">Productos para promoción</p>
        <h2 class="mt-2 text-2xl font-bold text-red-600">12</h2>
        <p class="mt-2 text-xs text-slate-500">Por vencimiento cercano</p>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-medium text-slate-500">Mes de mayor demanda</p>
        <h2 class="mt-2 text-2xl font-bold text-slate-900">Diciembre</h2>
        <p class="mt-2 text-xs text-emerald-700">+22% en ventas históricas</p>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-medium text-slate-500">Campañas activas</p>
        <h2 class="mt-2 text-2xl font-bold text-slate-900">3</h2>
        <p class="mt-2 text-xs text-slate-500">Granos, harinas y condimentos</p>
    </div>
</section>

<section class="mt-6 rounded-2xl border border-slate-200 bg-white">
    <div class="border-b border-slate-200 p-5">
        <h3 class="font-bold text-slate-900">Productos sugeridos para promoción</h3>
        <p class="text-sm text-slate-500">Priorizados por vencimiento y cantidad disponible.</p>
    </div>

    <div class="grid gap-4 p-5 md:grid-cols-3">
        <div class="rounded-2xl bg-red-50 p-4 border border-red-100">
            <p class="text-sm font-bold text-red-700">Frijol negro</p>
            <p class="mt-1 text-sm text-slate-600">Lote L-2394 · vence en 3 días</p>
            <p class="mt-3 text-xs font-semibold text-red-700">Sugerencia: descuento por volumen</p>
        </div>

        <div class="rounded-2xl bg-amber-50 p-4 border border-amber-100">
            <p class="text-sm font-bold text-amber-700">Harina de trigo</p>
            <p class="mt-1 text-sm text-slate-600">Stock bajo, alta rotación histórica</p>
            <p class="mt-3 text-xs font-semibold text-amber-700">Sugerencia: campaña preventiva</p>
        </div>

        <div class="rounded-2xl bg-slate-50 p-4 border border-slate-200">
            <p class="text-sm font-bold text-slate-700">Arroz blanco</p>
            <p class="mt-1 text-sm text-slate-600">Demanda alta en temporada</p>
            <p class="mt-3 text-xs font-semibold text-slate-600">Sugerencia: paquete promocional</p>
        </div>
    </div>
</section>