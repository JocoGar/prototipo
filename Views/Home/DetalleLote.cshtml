@{
    ViewData["Title"] = "Detalle de Lote";
}

<section class="mb-6">
    <div class="flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Detalle de Lote L-2394</h1>
            <p class="mt-1 text-sm text-slate-500">
                Trazabilidad del producto, movimientos, bodega, vencimiento y estado operativo.
            </p>
        </div>

        <a asp-action="SupervisorBodega" class="rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50">
            Volver a inventario
        </a>
    </div>
</section>

<section class="grid gap-4 md:grid-cols-4">
    <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-medium text-slate-500">Producto</p>
        <h2 class="mt-2 text-xl font-bold text-slate-900">Frijol negro</h2>
        <p class="mt-2 text-xs text-slate-500">Grado A</p>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-medium text-slate-500">Cantidad disponible</p>
        <h2 class="mt-2 text-2xl font-bold text-slate-900">450</h2>
        <p class="mt-2 text-xs text-slate-500">Packs de 100 lb registrados</p>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-medium text-slate-500">Fecha de vencimiento</p>
        <h2 class="mt-2 text-xl font-bold text-red-600">15/11/2026</h2>
        <p class="mt-2 text-xs text-red-600">Vence en 3 días</p>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-medium text-slate-500">Bodega</p>
        <h2 class="mt-2 text-xl font-bold text-slate-900">San Lucas</h2>
        <p class="mt-2 text-xs text-slate-500">Sucursal autorizada</p>
    </div>
</section>

<section class="mt-6 grid gap-4 xl:grid-cols-3">
    <div class="rounded-2xl border border-slate-200 bg-white p-5 xl:col-span-2">
        <h3 class="font-bold text-slate-900">Movimientos del lote</h3>

        <div class="mt-4 overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead class="bg-slate-50 text-xs uppercase text-slate-500">
                    <tr>
                        <th class="px-4 py-3">Fecha</th>
                        <th class="px-4 py-3">Movimiento</th>
                        <th class="px-4 py-3">Cantidad</th>
                        <th class="px-4 py-3">Usuario</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    <tr>
                        <td class="px-4 py-3">09/11/2026</td>
                        <td class="px-4 py-3">Entrada a bodega</td>
                        <td class="px-4 py-3">700</td>
                        <td class="px-4 py-3">atorres</td>
                    </tr>
                    <tr>
                        <td class="px-4 py-3">10/11/2026</td>
                        <td class="px-4 py-3">Salida por venta</td>
                        <td class="px-4 py-3">150</td>
                        <td class="px-4 py-3">cmendoza</td>
                    </tr>
                    <tr>
                        <td class="px-4 py-3">12/11/2026</td>
                        <td class="px-4 py-3">Salida por venta</td>
                        <td class="px-4 py-3">100</td>
                        <td class="px-4 py-3">bodega01</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="rounded-2xl border border-red-100 bg-red-50 p-5">
        <h3 class="font-bold text-red-700">Acción recomendada</h3>
        <p class="mt-2 text-sm text-slate-700">
            Este lote debe priorizarse para rotación o promoción debido a su vencimiento cercano.
        </p>

        <div class="mt-4 space-y-2">
            <a asp-action="Marketing" class="block rounded-xl bg-white px-4 py-2 text-center text-sm font-semibold text-red-700 border border-red-100 hover:bg-red-50">
                Enviar a marketing
            </a>
            <a asp-action="BodegaMovil" class="block rounded-xl bg-red-700 px-4 py-2 text-center text-sm font-semibold text-white hover:bg-red-800">
                Registrar salida
            </a>
        </div>
    </div>
</section>