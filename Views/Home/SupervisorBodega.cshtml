@{
    ViewData["Title"] = "Inventario y Lotes";
}

<section class="mb-6">
    <div class="flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Inventario y Lotes</h1>
            <p class="mt-1 text-sm text-slate-500">
                Consulta de existencias por bodega, lote, producto y fecha de vencimiento.
            </p>
        </div>

        <a href="/Home/SupervisorPlanta"
           class="rounded-xl bg-emerald-900 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-800">
            Registrar lote
        </a>
    </div>
</section>

<section class="grid gap-4 md:grid-cols-4">
    <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-medium text-slate-500">Lotes activos</p>
        <h2 class="mt-2 text-2xl font-bold text-slate-900">248</h2>
        <p class="mt-2 text-xs text-slate-500">Todas las bodegas</p>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-medium text-slate-500">Próximos a vencer</p>
        <h2 class="mt-2 text-2xl font-bold text-red-600">12</h2>
        <p class="mt-2 text-xs text-red-600">Menos de 7 días</p>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-medium text-slate-500">Stock bajo</p>
        <h2 class="mt-2 text-2xl font-bold text-amber-600">8</h2>
        <p class="mt-2 text-xs text-slate-500">Requiere compra</p>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-medium text-slate-500">Bodegas</p>
        <h2 class="mt-2 text-2xl font-bold text-slate-900">3</h2>
        <p class="mt-2 text-xs text-slate-500">Central, San Lucas, Antigua</p>
    </div>
</section>

<section class="mt-6 rounded-2xl border border-slate-200 bg-white">
    <div class="border-b border-slate-200 p-5">
        <h3 class="font-bold text-slate-900">Existencias por lote</h3>
        <p class="text-sm text-slate-500">Control de trazabilidad y vencimientos.</p>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
            <thead class="bg-slate-50 text-xs uppercase text-slate-500">
                <tr>
                    <th class="px-5 py-3">Lote</th>
                    <th class="px-5 py-3">Producto</th>
                    <th class="px-5 py-3">Bodega</th>
                    <th class="px-5 py-3">Cantidad</th>
                    <th class="px-5 py-3">Vencimiento</th>
                    <th class="px-5 py-3 text-right">Estado</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                <tr>
                    <td class="px-5 py-3 font-medium">L-2394</td>
                    <td class="px-5 py-3 text-slate-600">Frijol negro</td>
                    <td class="px-5 py-3">San Lucas</td>
                    <td class="px-5 py-3">450 packs</td>
                    <td class="px-5 py-3">15/11/2026</td>
                    <td class="px-5 py-3 text-right">
                        <span class="rounded-full bg-red-50 px-2 py-1 text-xs font-semibold text-red-700">Crítico</span>
                    </td>
                </tr>

                <tr>
                    <td class="px-5 py-3 font-medium">L-3110</td>
                    <td class="px-5 py-3 text-slate-600">Harina de trigo</td>
                    <td class="px-5 py-3">Central</td>
                    <td class="px-5 py-3">25 packs</td>
                    <td class="px-5 py-3">20/01/2027</td>
                    <td class="px-5 py-3 text-right">
                        <span class="rounded-full bg-amber-50 px-2 py-1 text-xs font-semibold text-amber-700">Stock mínimo</span>
                    </td>
                </tr>

                <tr>
                    <td class="px-5 py-3 font-medium">L-4108</td>
                    <td class="px-5 py-3 text-slate-600">Arroz blanco</td>
                    <td class="px-5 py-3">Antigua</td>
                    <td class="px-5 py-3">900 packs</td>
                    <td class="px-5 py-3">12/02/2027</td>
                    <td class="px-5 py-3 text-right">
                        <span class="rounded-full bg-emerald-50 px-2 py-1 text-xs font-semibold text-emerald-700">Normal</span>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</section>