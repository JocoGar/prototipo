@{
    ViewData["Title"] = "Ventas y Facturación FEL";
}

<section class="mb-6">
    <div class="flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Ventas y Facturación FEL</h1>
            <p class="mt-1 text-sm text-slate-500">
                Registro de ventas con validación de cliente, control de morosidad y emisión de factura electrónica.
            </p>
        </div>

        <button class="rounded-xl bg-emerald-900 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-800">
            Nueva venta
        </button>
    </div>
</section>

<section class="grid gap-4 md:grid-cols-3">
    <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-medium text-slate-500">Ventas registradas hoy</p>
        <h2 class="mt-2 text-2xl font-bold text-slate-900">34</h2>
        <p class="mt-2 text-xs text-slate-500">Incluye ambas sucursales</p>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-medium text-slate-500">Facturas FEL emitidas</p>
        <h2 class="mt-2 text-2xl font-bold text-emerald-700">31</h2>
        <p class="mt-2 text-xs text-slate-500">3 pendientes de confirmación</p>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm font-medium text-slate-500">Ventas bloqueadas</p>
        <h2 class="mt-2 text-2xl font-bold text-red-600">4</h2>
        <p class="mt-2 text-xs text-red-600">Clientes con saldo vencido</p>
    </div>
</section>

<section class="mt-6 grid gap-4 xl:grid-cols-3">
    <div class="rounded-2xl border border-slate-200 bg-white xl:col-span-2">
        <div class="border-b border-slate-200 p-5">
            <h3 class="font-bold text-slate-900">Ventas recientes</h3>
            <p class="text-sm text-slate-500">Control de pedidos, clientes, estado FEL y validación de mora.</p>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead class="bg-slate-50 text-xs uppercase text-slate-500">
                    <tr>
                        <th class="px-5 py-3">Factura</th>
                        <th class="px-5 py-3">Cliente</th>
                        <th class="px-5 py-3">Monto</th>
                        <th class="px-5 py-3">Estado</th>
                        <th class="px-5 py-3 text-right">Acción</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    <tr>
                        <td class="px-5 py-3 font-medium">FAC-2026-0891</td>
                        <td class="px-5 py-3 text-slate-600">Supermercados del Norte</td>
                        <td class="px-5 py-3">Q 12,450.00</td>
                        <td class="px-5 py-3">
                            <span class="rounded-full bg-emerald-50 px-2 py-1 text-xs font-semibold text-emerald-700">FEL emitida</span>
                        </td>
                        <td class="px-5 py-3 text-right">
                            <a asp-action="DetalleLote" class="font-semibold text-emerald-800 hover:underline">Ver</a>
                        </td>
                    </tr>

                    <tr>
                        <td class="px-5 py-3 font-medium">FAC-2026-0892</td>
                        <td class="px-5 py-3 text-slate-600">Distribuidora El Valle</td>
                        <td class="px-5 py-3">Q 8,900.00</td>
                        <td class="px-5 py-3">
                            <span class="rounded-full bg-amber-50 px-2 py-1 text-xs font-semibold text-amber-700">Pendiente FEL</span>
                        </td>
                        <td class="px-5 py-3 text-right">
                            <a asp-action="DetalleLote" class="font-semibold text-emerald-800 hover:underline">Ver</a>
                        </td>
                    </tr>

                    <tr>
                        <td class="px-5 py-3 font-medium">Bloqueada</td>
                        <td class="px-5 py-3 text-slate-600">Almacenes Roma</td>
                        <td class="px-5 py-3">Q 22,100.00</td>
                        <td class="px-5 py-3">
                            <span class="rounded-full bg-red-50 px-2 py-1 text-xs font-semibold text-red-700">Cliente moroso</span>
                        </td>
                        <td class="px-5 py-3 text-right">
                            <a asp-action="Contabilidad" class="font-semibold text-emerald-800 hover:underline">Cobranza</a>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="font-bold text-slate-900">Validaciones antes de vender</h3>

        <div class="mt-4 space-y-3">
            <div class="flex gap-3 rounded-xl bg-slate-50 p-3">
                <span class="material-symbols-outlined text-emerald-900">badge</span>
                <div>
                    <p class="text-sm font-semibold">Cliente registrado</p>
                    <p class="text-xs text-slate-500">Nombre, NIT, DPI y contacto obligatorio.</p>
                </div>
            </div>

            <div class="flex gap-3 rounded-xl bg-slate-50 p-3">
                <span class="material-symbols-outlined text-emerald-900">payments</span>
                <div>
                    <p class="text-sm font-semibold">Validación de mora</p>
                    <p class="text-xs text-slate-500">Bloquea ventas si existe saldo vencido.</p>
                </div>
            </div>

            <div class="flex gap-3 rounded-xl bg-slate-50 p-3">
                <span class="material-symbols-outlined text-emerald-900">receipt_long</span>
                <div>
                    <p class="text-sm font-semibold">Emisión FEL</p>
                    <p class="text-xs text-slate-500">Envío al certificador y copia interna.</p>
                </div>
            </div>
        </div>
    </div>
</section>